# 复制为 docker/.env 后按需修改；不要提交真实密钥。
# 站点对外地址（Caddy 自动签发证书需要真实域名）
APP_URL=https://example.com
DOMAIN=example.com

# 必填：至少 32 字符的随机串
REVALIDATE_SECRET=
PREVIEW_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 首次部署执行 seed 时创建的管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=站长

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=myself
MYSQL_USER=myself
MYSQL_PASSWORD=

# 图片域名白名单（逗号分隔，不含协议），用于 next/image
NEXT_IMAGE_HOSTS=

# 对象存储（MinIO）。生产可换成 R2 / OSS，只需改这几项。
S3_BUCKET=media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=
# 对象存储公开访问前缀；默认经 Caddy /media 反代到 MinIO
S3_PUBLIC_BASE=

# 联系表单邮件通知（可选，留空则不发送）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
