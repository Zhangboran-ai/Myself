# ===== 前端 =====
# 浏览器访问 API 的地址（跨端调试时改成局域网地址）
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# 服务端渲染访问 API 的地址
INTERNAL_API_URL=http://127.0.0.1:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 后台写操作后触发 ISR 失效的共享密钥
REVALIDATE_SECRET=change-me-to-a-long-random-string
# next/image 允许的远程图片域名（逗号分隔，不含协议）
NEXT_IMAGE_HOSTS=

# ===== 后端 =====
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# API 通知 Next.js 失效页面缓存的地址
INTERNAL_WEB_URL=http://127.0.0.1:3000
DATABASE_URL="mysql://myself:myself_dev_2026@127.0.0.1:3306/myself"
# 本地执行 prisma migrate dev 时使用的影子库
SHADOW_DATABASE_URL="mysql://myself:myself_dev_2026@127.0.0.1:3306/myself_shadow"

# 管理员（仅用于种子脚本初始化）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=站长

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# 草稿预览链接签名密钥（缺省时回退到 JWT_ACCESS_SECRET）
PREVIEW_SECRET=change-me-preview-secret-at-least-32-chars

# 对象存储（P1，未配置时上传接口不可用）
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=
S3_REGION=auto

# 联系表单通知（可选）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
